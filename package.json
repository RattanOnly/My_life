{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "TZ=Asia/Shanghai ./tools/hexo-env.sh clean && TZ=Asia/Shanghai ./tools/hexo-env.sh generate",
    "clean": "./tools/hexo-env.sh clean",
    "echo:index": "node tools/echo/build-index.mjs",
    "test": "node --test",
    "postbuild": "node tools/echo/build-index.mjs",
    "test:worker": "node --test worker/test/*.test.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "server": "./tools/hexo-env.sh server",
    "hexo:watch": "./tools/hexo-env.sh server --watch",
    "bs:proxy": "browser-sync start --proxy http://localhost:4000 --files public/**/* --reload-delay 200 --no-open",
    "predev": "./tools/hexo-env.sh clean && ./tools/hexo-env.sh generate && ./tools/hexo-env.sh algolia",
    "dev": "npm-run-all --parallel hexo:watch bs:proxy"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "hexo": "^8.1.2",
    "hexo-algoliasearch": "^2.0.1",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-landscape": "^1.0.0",
    "markdown-it": "^14.3.0"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "npm-run-all": "^4.1.5",
    "wrangler": "^4.111.0"
  }
}
