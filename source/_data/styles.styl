// Custom styles for NexT

// Enlarge left navigation menu text for better readability.
.site-nav .menu-item a,
.site-nav .menu-item span.exturl {
  font-size: 14px;
  line-height: 1.8;
}

// Customize site title font appearance.
.site-brand .site-title {
  font-family: "Times New Roman", Georgia, serif;
  font-size: 56px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: none;
}

// Limit post image height (and width on larger screens).
.post-body img {
  height: auto;
  // Fallback (older browsers): images never exceed viewport height.
  max-height: 70vh;
  // Modern browsers: additionally cap absolute height.
  max-height: unquote('min(70vh, 520px)');
}

@media (min-width: 768px) {
  .post-body img {
    max-width: 80%;
  }
}

// Keep theme brightness aligned with NexT defaults.
:root {
  --body-bg-color: #f5f5f5;
}

// Always-on global dimmer across all pages.
body::before {
  content: '';
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.12);
  pointer-events: none;
  z-index: 1;
}

.background-video-layer {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
  background: transparent;
}

.background-video-layer video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(1.2);
}

.background-video-layer .background-video-overlay {
  position: absolute;
  inset: 0;
  background: transparent;
  pointer-events: none;
}

body.has-background-video {
  background: transparent;
  .header,
  .header-inner,
  .main,
  .main-inner,
  .content-wrap,
  .posts-expand,
  .post-block,
  .sidebar,
  .sidebar-inner,
  .footer,
  .site-brand-container {
    background-color: rgba(8, 11, 16, 0.2);
  }
  .post-block {
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.14);
    backdrop-filter: blur(2px);
  }
}

.visitor-online-count {
  color: var(--text-color);
  font-size: 0.9em;
  line-height: 1.8;
}

.visitor-online-count[data-status='unavailable'] {
  opacity: 0.65;
}

// Visual effect theme: 3D falling leaves.
.site-effect {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: hidden;
  z-index: 2000;
}

.site-effect--leaves {
  perspective: 420px;
}

.site-effect--leaves .leaf-scene {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  transform-style: preserve-3d;
}

.site-effect--leaves .leaf-particle {
  position: absolute;
  top: 0;
  left: 0;
  width: 28px;
  height: 28px;
  background-image: url("data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 48 48%22%3E%3Cpath d=%22M5 41C10 20 25 6 43 4C40 24 27 38 8 43C11 34 20 23 33 13C20 20 12 31 5 41Z%22 fill=%22%2382a85f%22/%3E%3Cpath d=%22M8 42C17 30 27 20 39 9%22 fill=%22none%22 stroke=%22%235d7f3f%22 stroke-width=%222%22 stroke-linecap=%22round%22/%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-size: 100% 100%;
  backface-visibility: visible;
  filter: drop-shadow(0 4px 5px rgba(63, 86, 42, 0.16));
  opacity: 0.72;
  transform-style: preserve-3d;
  will-change: transform;
}

.site-effect--leaves .leaf-particle:nth-child(3n) {
  background-image: url("data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 48 48%22%3E%3Cpath d=%22M7 40C9 24 21 8 41 5C42 22 29 39 9 43C13 33 22 22 35 12C23 19 15 30 7 40Z%22 fill=%22%23b9aa58%22/%3E%3Cpath d=%22M10 41C18 31 28 20 38 9%22 fill=%22none%22 stroke=%22%23857933%22 stroke-width=%222%22 stroke-linecap=%22round%22/%3E%3C/svg%3E");
}

.site-effect--leaves .leaf-particle:nth-child(4n) {
  background-image: url("data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 48 48%22%3E%3Cpath d=%22M5 39C14 18 28 8 43 6C39 23 27 37 8 43C12 34 21 22 34 12C21 19 12 30 5 39Z%22 fill=%22%23779b4d%22/%3E%3Cpath d=%22M8 41C17 30 27 20 39 9%22 fill=%22none%22 stroke=%22%23506e34%22 stroke-width=%222%22 stroke-linecap=%22round%22/%3E%3C/svg%3E");
}

@media (max-width: 767px) {
  .site-effect--leaves .leaf-particle {
    filter: none;
    opacity: 0.64;
  }
}

@media (prefers-reduced-motion: reduce) {
  .site-effect--leaves {
    display: none;
  }
}

.article-comments {
  margin-top: 3rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--color-border, #eee);
}

.article-comments-title {
  margin: 0 0 1rem;
  font-size: 1.15rem;
}

.article-comments-list {
  display: grid;
  gap: 1rem;
  margin-bottom: 1.25rem;
}

.article-comment {
  padding: 0.9rem 0;
  border-bottom: 1px solid var(--color-border, #eee);
}

.article-comment-replies {
  display: grid;
  gap: 0.75rem;
  margin: 0.85rem 0 0 1rem;
  padding-left: 1rem;
  border-left: 2px solid var(--color-border, #eee);
}

.article-comment-reply {
  padding: 0.65rem 0;
  border-bottom: 0;
}

.article-comment-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 0.75rem;
  align-items: baseline;
  font-size: 0.9rem;
}

.article-comment-meta time,
.article-comments-empty,
.article-comments-status {
  color: var(--text-color-secondary, #777);
}

.article-comment p {
  margin: 0.45rem 0 0;
  line-height: 1.7;
  white-space: pre-wrap;
}

.article-comment-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  align-items: center;
  margin-top: 0.6rem;
}

.ui-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  padding: 0 0.85rem;
  border: 1px solid rgba(34, 34, 34, 0.14);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.68);
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  color: var(--text-color, #333);
  cursor: pointer;
  font: inherit;
  font-size: 0.88rem;
  font-weight: 500;
  line-height: 1;
  text-decoration: none;
  touch-action: manipulation;
  transition: background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease, color 180ms ease, transform 180ms ease;
}

.ui-button:hover {
  border-color: rgba(34, 34, 34, 0.24);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
}

.ui-button:active {
  transform: translateY(1px);
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
}

.ui-button:focus-visible {
  outline: 2px solid rgba(34, 34, 34, 0.26);
  outline-offset: 2px;
}

.ui-button-ghost {
  color: var(--link-color, #555);
}

.ui-button-danger {
  border-color: rgba(163, 51, 51, 0.22);
  color: #a33;
}

.ui-button-danger:hover {
  border-color: rgba(163, 51, 51, 0.34);
  background: rgba(255, 245, 245, 0.9);
  color: #8f2424;
}

.article-comment-action-button {
  flex: 0 0 auto;
}

@media (prefers-reduced-motion: reduce) {
  .ui-button {
    transition: none;
  }
}

.article-comment-deleted {
  color: var(--text-color-secondary, #777);
}

.article-comment-deleted p {
  font-style: italic;
}

.article-comments-form {
  display: grid;
  gap: 0.8rem;
}

.article-comments-replying {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 0.75rem;
  align-items: center;
  margin: 0;
  color: var(--text-color-secondary, #777);
  font-size: 0.9rem;
}

.article-comments-replying[hidden] {
  display: none;
}

.article-comments-replying button {
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--link-color, #555);
  cursor: pointer;
  font: inherit;
}

.article-comments-form label {
  display: grid;
  gap: 0.35rem;
}

.article-comments-form input,
.article-comments-form textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 0.65rem 0.75rem;
  border: 1px solid var(--color-border, #ddd);
  border-radius: 6px;
  background: var(--content-bg-color, #fff);
  color: var(--text-color, #333);
  font: inherit;
}

.article-comments-form button {
  justify-self: start;
  padding: 0.55rem 1rem;
  border: 0;
  border-radius: 6px;
  background: var(--link-color, #555);
  color: #fff;
  cursor: pointer;
}

.article-comments-status {
  min-height: 1.4em;
  margin: 0;
  font-size: 0.9rem;
}

.article-comments[data-status='unavailable'] .article-comments-status {
  color: #a33;
}

.admin-dashboard {
  margin-top: 2rem;
}

.admin-login,
.admin-section,
.admin-comment {
  margin-bottom: 1rem;
  padding: 1rem;
  border: 1px solid var(--color-border, #ddd);
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.55);
}

.admin-login label {
  display: block;
  margin-bottom: 0.75rem;
}

.admin-login input {
  display: block;
  width: 100%;
  box-sizing: border-box;
  margin-top: 0.35rem;
  padding: 0.55rem 0.65rem;
  border: 1px solid var(--color-border, #bbb);
  border-radius: 4px;
  font: inherit;
}

.admin-login button,
.admin-comment button,
.admin-filter-form button,
.admin-pagination button {
  min-height: 44px;
  padding: 0.55rem 0.9rem;
  border: 0;
  border-radius: 4px;
  color: #fff;
  background: var(--link-color, #444);
  cursor: pointer;
}

.admin-filter-form button[disabled],
.admin-pagination button[disabled] {
  opacity: 0.45;
  cursor: not-allowed;
}

.admin-status {
  min-height: 1.5rem;
  color: #a33;
}

.admin-filter-form {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.75rem;
  align-items: end;
  margin-bottom: 1rem;
}

.admin-filter-form label {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 0.35rem;
  color: var(--text-color-secondary, #666);
  font-size: 0.9rem;
}

.admin-filter-form input,
.admin-filter-form select {
  min-height: 44px;
  width: 100%;
  box-sizing: border-box;
  padding: 0.5rem 0.6rem;
  border: 1px solid var(--color-border, #bbb);
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.72);
  color: var(--text-color, #333);
  font: inherit;
}

.admin-filter-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  grid-column: 1 / -1;
}

.admin-table-wrap {
  overflow-x: auto;
}

.admin-table {
  width: 100%;
  border-collapse: collapse;
}

.admin-table th,
.admin-table td {
  padding: 0.5rem;
  border-bottom: 1px solid var(--color-border, #ddd);
  text-align: left;
  vertical-align: top;
}

.admin-empty-cell {
  color: var(--text-color-secondary, #666);
  text-align: center;
}

.admin-pagination {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  align-items: center;
  justify-content: flex-end;
  margin-top: 1rem;
}

.admin-pagination span {
  color: var(--text-color-secondary, #666);
  font-size: 0.92rem;
}

.admin-comment-meta,
.admin-comment-path,
.admin-comment-email {
  color: var(--text-color-secondary, #666);
  font-size: 0.9em;
}

.admin-comment-body {
  white-space: pre-wrap;
}

@media (max-width: 700px) {
  .admin-filter-form {
    grid-template-columns: 1fr;
  }

  .admin-filter-actions,
  .admin-pagination {
    align-items: stretch;
    flex-direction: column;
  }

  .admin-filter-form button,
  .admin-pagination button {
    width: 100%;
  }
}
